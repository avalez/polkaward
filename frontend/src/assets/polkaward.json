      {
        "args": [],
        "default": false,
        "docs": [
          " RELEASE PAYMENT",
          " Called by the Client to pay the Provider, or by the Arbitrator to settle a dispute in favor of the Provider."
        ],
        "label": "release_payment",
        "mutates": true,
        "payable": false,
